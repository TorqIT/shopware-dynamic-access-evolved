<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <!-- Access Rule Service - Handles rule matching and filter application -->
        <service id="Torq\Shopware\DynamicAccessEvolved\Service\AccessRuleService">
            <argument type="service" id="torq_dynamic_access_evolved.repository"/>
            <argument type="service" id="Shopware\Core\Content\Product\ProductDefinition"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\SalesChannelProductDefinition"/>
            <argument type="service" id="product.repository"/>
        </service>

        <!-- Product Process Criteria Event Subscriber -->
        <service id="Torq\Shopware\DynamicAccessEvolved\Subscriber\DynamicAccessEvolvedSubscriber">
            <argument type="service" id="Torq\Shopware\DynamicAccessEvolved\Service\AccessRuleService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Available Combination Loader Decorator - Filters configurator settings by access rules -->
        <service id="Torq\Shopware\DynamicAccessEvolved\Core\Content\Product\SalesChannel\Detail\AvailableCombinationLoaderDecorator"
                 decorates="Shopware\Core\Content\Product\SalesChannel\Detail\AvailableCombinationLoader">
            <argument type="service" id="Torq\Shopware\DynamicAccessEvolved\Core\Content\Product\SalesChannel\Detail\AvailableCombinationLoaderDecorator.inner"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Torq\Shopware\DynamicAccessEvolved\Service\AccessRuleService"/>
        </service>

        <service id="Torq\Shopware\DynamicAccessEvolved\Entity\DynamicAccessEvolved\DynamicAccessEvolvedDefinition">
            <tag name="shopware.entity.definition" entity="torq_dynamic_access_evolved" />
        </service>

        <service id="Torq\Shopware\DynamicAccessEvolved\Entity\DynamicAccessEvolvedCustomerRule\DynamicAccessEvolvedCustomerRuleDefinition">
            <tag name="shopware.entity.definition" entity="torq_dynamic_access_evolved_customer_rule" />
        </service>

        <service id="Torq\Shopware\DynamicAccessEvolved\Entity\DynamicAccessEvolvedSalesChannel\DynamicAccessEvolvedSalesChannelDefinition">
            <tag name="shopware.entity.definition" entity="torq_dynamic_access_evolved_sales_channel" />
        </service>

        <service id="Torq\Shopware\DynamicAccessEvolved\Entity\Extension\RuleExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="Torq\Shopware\DynamicAccessEvolved\Entity\Extension\SalesChannelExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <!-- <service id="Torq\Shopware\DynamicAccessEvolved\Service\CustomFieldsInstaller">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field_set_relation.repository"/>
        </service> -->

        <!-- Elasticsearch Product Definition Decorator to add streamIds field -->
        <service id="Torq\Shopware\DynamicAccessEvolved\Elasticsearch\DynamicAccessEvolvedElasticsearchProductDefinitionDecorator"
                 decorates="Shopware\Elasticsearch\Product\ElasticsearchProductDefinition"
                 decoration-priority="-1000">
            <argument type="service" id="Torq\Shopware\DynamicAccessEvolved\Elasticsearch\DynamicAccessEvolvedElasticsearchProductDefinitionDecorator.inner"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

    </services>
</container>